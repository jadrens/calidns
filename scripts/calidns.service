[Unit]
Description=CaliDNS authoritative DNS server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=calidns
Group=calidns
ConfigurationDirectory=calidns
ConfigurationDirectoryMode=0750
StateDirectory=calidns
StateDirectoryMode=0750
WorkingDirectory=/var/lib/calidns
ExecStart=/usr/bin/calidns -config /etc/calidns/config.yaml -data-dir /var/lib/calidns
Restart=on-failure
RestartSec=5s
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/calidns /var/lib/calidns

[Install]
WantedBy=multi-user.target
